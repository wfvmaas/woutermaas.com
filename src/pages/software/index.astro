---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"
import ScrollIndicator from "../../components/ScrollIndicator.astro"

const projects = (await getCollection("software")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
)
---

<BaseLayout title="Software">
  <div class="overview-page">
    <div class="page-header">
      <div class="header-content">
        <div class="illustration-container">
          <img
            src="/doodles/software_factory.svg"
            alt="Software Factory"
            class="header-illustration"
          />
        </div>
        <div class="text-content">
          <h1>Software</h1>
          <p class="intro-text">
            In need of a creative programmer? I like to build software for all
            kinds of purposes but preferably I work on projects that make the
            world a little more interesting
          </p>
        </div>
        <div class="scroll-indicator-wrapper">
          <ScrollIndicator target="#projects-list" />
        </div>
      </div>
    </div>

    <div class="projects-list" id="projects-list">
      {
        projects.map((project) => (
          <article class="project-item">
            <h2 class="project-title">{project.data.title}</h2>
            {project.data.heroImage && (
              <div class="project-image">
                <img
                  src={
                    typeof project.data.heroImage === "string"
                      ? project.data.heroImage
                      : project.data.heroImage.src
                  }
                  alt={project.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="project-content">
              <p class="project-description">{project.body}</p>
              {project.data.title === "STOOR.net" && (
                <a
                  href="https://stoor.net"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="learn-more-btn"
                >
                  Learn more
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import "../../styles/variables.less";
  @import "../../styles/mixins.less";

  .overview-page {
    padding-top: @spacing-24;
    padding-bottom: @spacing-24;
    max-width: 600px;
    margin: 0 auto;
    padding-left: @spacing-6;
    padding-right: @spacing-6;

    @media (min-width: @screen-lg) {
      max-width: @container-max-width;
      padding-top: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .page-header {
      margin-bottom: @spacing-16;
      text-align: center;

      @media (min-width: @screen-lg) {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0;
      }

      .header-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @spacing-8;
        position: relative;
        width: 100%;

        @media (min-width: @screen-lg) {
          flex-direction: row-reverse;
          justify-content: space-between;
          gap: @spacing-16;
          padding: 0 @spacing-16;
        }

        .illustration-container {
          width: 100%;
          max-width: 300px;
          margin: 0 auto;

          @media (min-width: @screen-lg) {
            max-width: 500px;
            margin: 0;
          }

          img {
            width: 100%;
            height: auto;
          }
        }

        .text-content {
          @media (min-width: @screen-lg) {
            text-align: left;
            max-width: 500px;
          }

          h1 {
            font-size: @text-5xl;
            font-weight: 700;
            margin: 0;

            @media (min-width: @screen-lg) {
              font-size: @text-8xl;
              margin-bottom: @spacing-8;
            }
          }

          .intro-text {
            font-size: @text-lg;
            line-height: 1.6;
            color: @color-gray-900;
            max-width: 40ch;

            @media (min-width: @screen-lg) {
              font-size: @text-xl;
              max-width: 100%;
            }
          }
        }

        .scroll-indicator-wrapper {
          margin-top: @spacing-8;

          @media (min-width: @screen-lg) {
            position: absolute;
            bottom: -20vh;
            left: 50%;
            transform: translateX(-50%);
          }
        }
      }
    }

    .projects-list {
      display: flex;
      flex-direction: column;
      gap: @spacing-16;

      @media (min-width: @screen-lg) {
        padding: @spacing-24 @spacing-16;
        gap: @spacing-32;
      }

      .project-item {
        display: flex;
        flex-direction: column;
        gap: @spacing-6;

        @media (min-width: @screen-lg) {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: @spacing-16;
          align-items: center;

          &:nth-child(even) {
            direction: rtl;

            .project-content,
            .project-title {
              direction: ltr;
            }
          }
        }

        .project-title {
          font-size: @text-2xl;
          font-weight: 600;
          margin: 0;

          @media (min-width: @screen-lg) {
            grid-column: 1 / -1;
            font-size: @text-4xl;
            margin-bottom: @spacing-4;
          }
        }

        .project-image {
          width: 100%;
          border-radius: @radius-lg;
          overflow: hidden;
          background: @color-gray-100;

          img {
            width: 100%;
            height: auto;
            display: block;
            aspect-ratio: 16/9;
            object-fit: cover;
          }
        }

        .project-content {
          .project-description {
            font-size: @text-base;
            line-height: 1.6;
            color: @color-gray-800;
            margin-bottom: @spacing-6;

            @media (min-width: @screen-lg) {
              font-size: @text-lg;
            }
          }

          .learn-more-btn {
            display: inline-block;
            width: 100%;
            padding: @spacing-3 @spacing-6;
            text-align: center;
            background: transparent;
            border: 1px solid @color-black;
            border-radius: @radius-md;
            color: @color-black;
            font-weight: 500;
            text-decoration: none;
            .transition(all);

            @media (min-width: @screen-lg) {
              width: auto;
            }

            &:hover {
              background: @color-black;
              color: white;
            }
          }
        }
      }
    }
  }
</style>
