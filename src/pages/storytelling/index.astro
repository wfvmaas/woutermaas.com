---
import { getOverviewContent } from "../../utils/contentHelpers"
import { getImage } from "astro:assets"
import OverviewPageLayout from "../../layouts/OverviewPageLayout.astro"

const { heroData, projects } = await getOverviewContent("storytelling")

if (!heroData) throw new Error("Storytelling overview not found")

// Handle heroImage - can be string or image object
const heroImage = heroData.heroImage
  ? typeof heroData.heroImage === "string"
    ? heroData.heroImage
    : (heroData.heroImage as any).src
  : ""
---

<OverviewPageLayout
  category="storytelling"
  title={heroData.title}
  introText={heroData.introText ?? ""}
  heroImage={heroImage}
  projects={projects}
/>
