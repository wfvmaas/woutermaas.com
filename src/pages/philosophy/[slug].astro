---
import { getCollection } from "astro:content"
import { getImage } from "astro:assets"
import DetailPageLayout from "../../layouts/DetailPageLayout.astro"

export const prerender = true

export async function getStaticPaths() {
  const projects = await getCollection("philosophy")

  // Filter out overview page (index.md)
  return projects
    .filter((project) => project.slug !== "index")
    .map((project) => ({
      params: { slug: project.slug },
    }))
}

const { slug } = Astro.params
const projects = await getCollection("philosophy")
const project = projects.find((p) => p.slug === slug)

if (!project) {
  throw new Error(`Project not found: ${slug}`)
}

const { Content } = await project.render()

const heroImage = project.data.heroImage
  ? typeof project.data.heroImage === "string"
    ? project.data.heroImage
    : (project.data.heroImage as any).src
  : undefined
---

<DetailPageLayout
  title={project.data.title}
  hero_text={project.data.hero_text}
  heroImage={heroImage}
>
  <Content />
</DetailPageLayout>
