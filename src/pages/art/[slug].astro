---
import { getCollection } from "astro:content"
import { getImage } from "astro:assets"
import DetailPageLayout from "../../layouts/DetailPageLayout.astro"

export const prerender = true

export async function getStaticPaths() {
  const projects = await getCollection("art")

  // Filter out overview pages (starting with "0") and strip numerical prefixes
  return projects
    .filter((project) => !project.slug.startsWith("0"))
    .map((project) => {
      // Strip numerical prefix (e.g., "1project" or "1.project" -> "project")
      const cleanSlug = project.slug.replace(/^\d+\.?/, "")
      return {
        params: { slug: cleanSlug },
        props: { originalSlug: project.slug },
      }
    })
}

const { originalSlug } = Astro.props
const projects = await getCollection("art")
const project = projects.find((p) => p.slug === originalSlug)

if (!project) {
  throw new Error(`Project not found: ${originalSlug}`)
}

const { Content } = await project.render()

// For content collection images, use .src directly
let heroImage: string | undefined = undefined
if (project.data.heroImage) {
  if (typeof project.data.heroImage === "string") {
    heroImage = project.data.heroImage
  } else {
    heroImage = (project.data.heroImage as any).src
  }
}
---

<DetailPageLayout
  title={project.data.title}
  abstract={project.data.abstract}
  heroImage={heroImage}
>
  <Content />
</DetailPageLayout>
