---
import { getCollection } from "astro:content"
import ProjectPageLayout from "../../layouts/ProjectPageLayout.astro"

export async function getStaticPaths() {
  const projects = await getCollection("art")
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await project.render()

const heroImage = project.data.heroImage
  ? typeof project.data.heroImage === "string"
    ? project.data.heroImage
    : project.data.heroImage.src
  : undefined
---

<ProjectPageLayout
  title={project.data.title}
  abstract={project.data.abstract}
  heroImage={heroImage}
>
  <Content />
</ProjectPageLayout>
