---
import { getCollection } from "astro:content"
import { getImage } from "astro:assets"
import DetailPageLayout from "../../layouts/DetailPageLayout.astro"

export const prerender = true

export async function getStaticPaths() {
  const projects = await getCollection("art")

  // Filter out overview page (index.md)
  return projects
    .filter((project) => project.slug !== "index")
    .map((project) => ({
      params: { slug: project.slug },
    }))
}

const { slug } = Astro.params
const projects = await getCollection("art")
const project = projects.find((p) => p.slug === slug)

if (!project) {
  throw new Error(`Project not found: ${slug}`)
}

const { Content } = await project.render()

// For content collection images, use .src directly
let heroImage: string | undefined = undefined
if (project.data.heroImage) {
  if (typeof project.data.heroImage === "string") {
    heroImage = project.data.heroImage
  } else {
    heroImage = (project.data.heroImage as any).src
  }
}
---

<DetailPageLayout
  title={project.data.title}
  hero_text={project.data.hero_text}
  heroImage={heroImage}
>
  <Content />
</DetailPageLayout>
