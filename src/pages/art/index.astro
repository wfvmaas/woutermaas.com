---
import { getCollection, getEntry } from "astro:content"
import OverviewPageLayout from "../../layouts/OverviewPageLayout.astro"

const overview = await getEntry("overviews", "art")
if (!overview) throw new Error("Art overview not found")

// Fetch both full projects and overview-only entries
const fullProjects = await getCollection("art")
const overviewOnlyProjects = await getCollection("art-overview-only")

// Merge and sort by order
const allProjects = [...fullProjects, ...overviewOnlyProjects].sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
)
---

<OverviewPageLayout
  category="art"
  title={overview.data.title}
  introText={overview.data.introText}
  heroImage={overview.data.heroImage}
  projects={allProjects}
/>
