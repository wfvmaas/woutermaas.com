---
import { getCollection, getEntry } from "astro:content"
import OverviewPage from "../../components/OverviewPage.astro"

const overview = await getEntry("overviews", "art")
const projects = (await getCollection("art")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
)
---

<OverviewPage
  category="art"
  title={overview.data.title}
  introText={overview.data.introText}
  heroImage={overview.data.heroImage}
  projects={projects}
/>
