---
import { getOverviewContent } from "../../utils/contentHelpers"
import OverviewPageLayout from "../../layouts/OverviewPageLayout.astro"

const { heroData, projects, abstracts } = await getOverviewContent("art")

if (!heroData) throw new Error("Art overview not found")

// Merge projects and abstracts
const allProjects = [...projects, ...abstracts]
---

<OverviewPageLayout
  category="art"
  title={heroData.title}
  introText={heroData.introText ?? ""}
  heroImage={heroData.heroImage ?? ""}
  projects={allProjects}
/>
