---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const hikes = await getCollection("hiking")
---

<BaseLayout title="Hiking">
  <div class="hiking-page">
    <div class="page-header">
      <h1>Hiking</h1>
      <img
        src="/doodles/hiking_tent.svg"
        alt="Hiking Tent"
        class="header-illustration"
      />
    </div>
    <div class="hikes-grid">
      {
        hikes.length > 0 ? (
          hikes.map((hike) => (
            <a href={`/hiking/${hike.slug}`} class="hike-card">
              <div class="hike-background">{/* Image would go here */}</div>
              <div class="hike-overlay" />
              <div class="hike-content">
                <h2>{hike.data.title}</h2>
                <p>{hike.data.description}</p>
              </div>
            </a>
          ))
        ) : (
          <p class="empty-state">Adventures coming soon...</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .hiking-page {
    .container();
    padding-top: @spacing-20;
    padding-bottom: @spacing-20;

    .page-header {
      text-align: center;
      margin-bottom: @spacing-20;

      h1 {
        font-size: @text-6xl;
        font-weight: 700;
        letter-spacing: -0.05em;
        margin: 0 0 @spacing-8 0;

        @media (min-width: @screen-md) {
          font-size: @text-8xl;
        }
      }

      .header-illustration {
        margin: 0 auto;
        width: 100%;
        max-width: 64rem;
      }
    }

    .hikes-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: @spacing-12;

      .hike-card {
        display: block;
        position: relative;
        height: 24rem;
        border-radius: 1.5rem;
        overflow: hidden;

        .hike-background {
          position: absolute;
          inset: 0;
          background: @color-gray-200;
        }

        .hike-overlay {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.2);
          .transition(background);
        }

        &:hover .hike-overlay {
          background: rgba(0, 0, 0, 0.4);
        }

        .hike-content {
          position: absolute;
          bottom: 0;
          left: 0;
          padding: @spacing-8;
          color: white;

          h2 {
            font-size: @text-4xl;
            font-weight: 700;
            margin: 0 0 @spacing-2 0;
          }

          p {
            font-size: @text-lg;
            opacity: 0.9;
            margin: 0;
          }
        }
      }
    }

    .empty-state {
      text-align: center;
      color: @color-gray-500;
      font-style: italic;
    }
  }
</style>
