---
import BaseLayout from '../layouts/BaseLayout.astro';
import WizardMenuButton from '../components/WizardMenuButton.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
---

<BaseLayout
  title="Home"
  showFooter={true}
  showWizardMenu={false}
  showNavigation={false}
>
  <div class="home-page layout-outer-container">
    <!-- Sticky Illustrations Container -->
    <div class="home-page__sticky-illustrations">
      <!-- Dragon (Center/Right) -->

      <div class="home-page__dragon-container">
        <img
          src="/doodles/flying_dragon_animation.webp"
          alt="Dragon"
          class="home-page__dragon"
        />

        <img
          src="/doodles/spell_attack_purple_animation_6fps.webp"
          alt="Wizard"
          class="home-page__spell-attack"
        />
      </div>

      <div class="home-page__wizard-container">
        <WizardMenuButton isHomePage={true} />

        <img
          src="/doodles/shield_animation_6fps.webp"
          alt="Shield"
          class="home-page__shield"
        />
      </div>
    </div>

    <!-- Mobile Wizard Menu Button -->

    <!-- Scrollable Content -->
    <div class="home-page__scrollable-content">
      <!-- Hero Section -->
      <section class="home-page__hero-section">
        <div class="home-page__content">
          <h1>Hello</h1>

          <div class="home-page__intro-text">
            <p>
              My name is Wouter a creative software wizard who likes to build
              all sorts of things
            </p>
            <p>Feel invited to get to know one of my many wizard hats</p>
          </div>
        </div>
      </section>

      <!-- Scroll Indicator -->
      <div class="home-page__scroll-indicator-wrapper">
        <ScrollIndicator scale={1.5} target="#home-page__menu-section" />
      </div>

      <!-- Menu Section -->
      <section class="home-page__menu-section" id="home-page__menu-section">
        <nav>
          <ul>
            <li>
              <a href="/software"> Software </a>
            </li>
            <li>
              <a href="/storytelling"> Storytelling </a>
            </li>
            <li>
              <a href="/philosophy"> Philosophy </a>
            </li>
            <li>
              <a href="/art"> Art </a>
            </li>
            <li>
              <a href="/hiking"> Hiking </a>
            </li>
            <li>
              <a href="/contact"> Contact </a>
            </li>
          </ul>
        </nav>
      </section>
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import '../styles/variables.less';
  @import '../styles/mixins.less';

  .home-page {
    // Padding handled by layout-outer-container

    &__sticky-illustrations {
      @media (max-width: @screen-md) {
        position: absolute;
        pointer-events: none;
        z-index: 0;
      }

      @media (min-width: @screen-md) {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }
    }

    // Wizard animation
    &__wizard-container {
      position: absolute;
      top: 100px;
      right: 100px;
    }

    &__shield {
      position: absolute;
      top: -120px;
      right: 10px;
      width: 15rem;
    }

    // Dragon animation
    &__dragon-container {
      position: absolute;
      top: 15%;
      left: 20%;
    }

    &__dragon {
      position: absolute;
      top: 0;
      left: 0;
      width: 20rem;

      @media (min-width: @screen-md) {
      }

      @media (min-width: @screen-lg) {
      }
    }

    &__spell-attack {
      display: none;
      position: absolute;
      top: -80px;
      left: 255px;
      width: 20rem;
    }



    &__scrollable-content {
      position: relative;
      z-index: 10;
    }

    &__scroll-indicator-wrapper {
      position: absolute;
      left: 50%;
      top: 90vh;
      transform: translateX(-50%);
      width: fit-content;
      z-index: 20;
    }

    &__hero-section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    &__content {
      max-width: 48rem;
      padding-top: 45vh;

      h1 {
        font-size: 6.5rem;
        font-weight: 600;
        letter-spacing: -0.05em;
        line-height: 1;
        margin: 0 0 @spacing-8 0;

        @media (min-width: @screen-sm) {
          font-size: 7rem;
        }

        @media (min-width: @screen-md) {
          font-size: 8rem;
        }

        @media (min-width: @screen-lg) {
          font-size: 12rem;
        }
      }
    }

    &__intro-text {
      font-size: @text-base;
      font-weight: 500;
      max-width: 36rem;

      @media (min-width: @screen-md) {
        font-size: @text-lg;
      }

      @media (min-width: @screen-lg) {
        font-size: @text-xl;
      }

      p {
        margin-bottom: @spacing-6;
      }
    }

    &__menu-section {
      min-height: 100vh;
      display: flex;
      align-items: center;

      nav {
        width: fit-content;

        ul {
          list-style: none;
          padding: 0;
          margin: 0;

          li {
            margin-bottom: @spacing-4;

            @media (min-width: @screen-md) {
              margin-bottom: @spacing-6;
            }

            a {
              display: flex;
              align-items: center;
              font-size: @text-4xl;
              font-weight: 700;
              .transition(color);
              position: relative; // For absolute positioning of bullet

              @media (min-width: @screen-md) {
                font-size: @text-5xl;
              }

              @media (min-width: @screen-lg) {
                font-size: @text-6xl;
              }

              &:hover {
                color: @color-gray-300;

                &::before {
                  opacity: 1;
                }
              }

              &::before {
                content: '';
                // Hide on mobile
                display: none;

                // Show on desktop only
                @media (min-width: @screen-md) {
                  display: block;
                  position: absolute;
                  left: -@spacing-6; // Position to the left of text
                  top: 50%;
                  transform: translateY(-50%);
                  width: @spacing-4;
                  height: @spacing-4;
                  background-color: @color-black;
                  border-radius: 50%;
                  opacity: 0;
                  .transition(opacity);
                }
              }
            }
          }
        }
      }
    }
  }
</style>
