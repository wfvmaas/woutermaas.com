---
import BaseLayout from '../layouts/BaseLayout.astro';
import WizardMenuButton from '../components/WizardMenuButton.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
---

<BaseLayout
  title="Home"
  showFooter={true}
  showWizardMenu={false}
  showNavigation={false}
>
  <div class="home-page layout-outer-container">
    <!-- Sticky Illustrations Container -->
    <div class="home-page__sticky-illustrations">
      <!-- Dragon (Center/Right) -->

      <div class="home-page__dragon-container">
        <img
          src="/doodles/flying_dragon_animation.webp"
          alt="Dragon"
          class="home-page__dragon"
        />

        <img
          data-src="/doodles/spell_attack_purple_animation_6fps.webp"
          alt=""
          class="home-page__spell-attack"
          loading="lazy"
        />
      </div>

      <div class="home-page__wizard-container">
        <WizardMenuButton isHomePage={true} hasMenuLabel={false} />

        <img
          data-src="/doodles/shield_animation_6fps.webp"
          alt=""
          class="home-page__shield"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Scrollable Content -->
    <div class="home-page__scrollable-content">
      <!-- Hero Section -->
      <section class="home-page__hero-section">
        <div class="home-page__content">
          <h1>Hello</h1>

          <div class="home-page__intro-text">
            <p>
              My name is Wouter a creative software wizard who likes to build
              all sorts of things
            </p>
            <p>Feel invited to get to know one of my many wizard hats</p>
          </div>
        </div>
      </section>

      <!-- Scroll Indicator -->
      <div class="home-page__scroll-indicator-wrapper">
        <ScrollIndicator scale={1.5} target="#home-page__menu-section" />
      </div>

      <!-- Menu Section -->
      <section class="home-page__menu-section" id="home-page__menu-section">
        <nav>
          <ul>
            <li>
              <a href="/software"> Software </a>
            </li>
            <li>
              <a href="/storytelling"> Storytelling </a>
            </li>
            <li>
              <a href="/philosophy"> Philosophy </a>
            </li>
            <li>
              <a href="/art"> Art </a>
            </li>
            <li>
              <a href="/hiking"> Hiking </a>
            </li>
            <li>
              <a href="/contact"> Contact </a>
            </li>
          </ul>
        </nav>
      </section>
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import '../styles/variables.less';
  @import '../styles/mixins.less';

  .home-page {
    // Padding handled by layout-outer-container

    &__sticky-illustrations {
      position: relative;
      pointer-events: none;
      z-index: 10;

      @media (min-width: @screen-lg) {
        position: fixed;
        inset: 0;
      }
    }

    // Wizard animation
    &__wizard-container {
      position: absolute;
      top: 120px;
      right: 0px;
      pointer-events: auto;

      // Start completely off-screen to the right
      transform: translateX(400%);
      transition: transform 1.5s ease-in-out;
      animation:
        slideInFromRight 1.5s cubic-bezier(0.25, 0.46, 0.45, 1) forwards,
        hoverUpDown 3s ease-in-out infinite;
      animation-delay: 0.2s, 1.7s;

      @media (min-width: @screen-md) {
        top: 160px;
        right: 86.67px;
      }

      @media (min-width: @screen-lg) {
        top: 240px;
        right: 155px;
      }

      // Wizard button styles when on home page
      :global(.wizard-menu-button.wizard-menu-button__home-page) {
        position: relative;
        top: 0;
        right: 0;

        :global(img) {
          width: 3.5rem;
          height: auto;

          @media (min-width: @screen-md) {
            width: 5rem;
          }

          @media (min-width: @screen-lg) {
            width: 6rem;
          }
        }
      }
    }

    &__shield {
      position: absolute;
      top: -60px;
      right: 0px;
      width: 7.5rem;
      opacity: 1;

      @media (min-width: @screen-md) {
        top: -90px;
        right: 0px;
        width: 12rem;
      }
      @media (min-width: @screen-lg) {
        top: -120px;
        right: 0px;
        width: 15rem;
      }

      &--hidden {
        display: none;
      }
    }

    // Dragon animation
    &__dragon-container {
      position: absolute;
      top: 100px;
      right: 348px;

      // Start at exact bottom left corner of screen
      transform: translateX(-100vw) translateY(100vh) rotate(0deg);
      opacity: 1;
      animation: rollercoasterLoop 3.5s linear forwards;
      animation-delay: 2s;

      @media (min-width: @screen-md) {
        top: 115px;
        right: 700px;
      }

      @media (min-width: @screen-lg) {
        top: 195px;
        right: 845px;
      }
    }

    &__dragon {
      position: absolute;
      top: 0;
      left: 0;
      width: 10rem;

      @media (min-width: @screen-md) {
        width: 18rem;
      }

      @media (min-width: @screen-lg) {
        width: 20rem;
      }
    }

    &__spell-attack {
      position: absolute;
      top: -40px;
      left: 127.5px;
      width: 10rem;
      opacity: 1;

      @media (min-width: @screen-md) {
        top: -70px;
        left: 235px;
        width: 18rem;
      }

      @media (min-width: @screen-lg) {
        top: -80px;
        left: 255px;
        width: 20rem;
      }

      &--hidden {
        display: none;
      }
    }

    &__scrollable-content {
      position: relative;
      z-index: 1;
    }

    &__scroll-indicator-wrapper {
      position: absolute;
      left: 50%;
      top: 90vh;
      transform: translateX(-50%);
      width: fit-content;
    }

    &__hero-section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    &__content {
      max-width: 48rem;
      padding-top: 45vh;

      h1 {
        font-size: 6.5rem;
        font-weight: 600;
        letter-spacing: -0.05em;
        line-height: 1;
        margin: 0 0 @spacing-8 0;

        @media (min-width: @screen-sm) {
          font-size: 7rem;
        }

        @media (min-width: @screen-md) {
          font-size: 8rem;
        }

        @media (min-width: @screen-lg) {
          font-size: 12rem;
        }
      }
    }

    &__intro-text {
      font-size: @text-base;
      font-weight: 500;
      max-width: 36rem;

      @media (min-width: @screen-md) {
        font-size: @text-lg;
      }

      @media (min-width: @screen-lg) {
        font-size: @text-xl;
      }

      p {
        margin-bottom: @spacing-6;
      }
    }

    &__menu-section {
      min-height: 100vh;
      display: flex;
      align-items: center;

      nav {
        width: fit-content;

        ul {
          list-style: none;
          padding: 0;
          margin: 0;

          li {
            margin-bottom: @spacing-4;

            @media (min-width: @screen-md) {
              margin-bottom: @spacing-6;
            }

            a {
              display: flex;
              align-items: center;
              font-size: @text-4xl;
              font-weight: 700;
              .transition(color);
              position: relative; // For absolute positioning of bullet

              @media (min-width: @screen-md) {
                font-size: @text-5xl;
              }

              @media (min-width: @screen-lg) {
                font-size: @text-6xl;
              }

              &:hover {
                color: @color-gray-300;

                &::before {
                  opacity: 1;
                }
              }

              &::before {
                content: '';
                // Hide on mobile
                display: none;

                // Show on desktop only
                @media (min-width: @screen-md) {
                  display: block;
                  position: absolute;
                  left: -@spacing-6; // Position to the left of text
                  top: 50%;
                  transform: translateY(-50%);
                  width: @spacing-4;
                  height: @spacing-4;
                  background-color: @color-black;
                  border-radius: 50%;
                  opacity: 0;
                  .transition(opacity);
                }
              }
            }
          }
        }
      }
    }
  }

  // Keyframe animation for wizard container - smooth sine wave motion
  // Vertical movement follows true sine curve, horizontal follows easing
  @keyframes slideInFromRight {
    0% {
      transform: translateX(400%) translateY(0);
    }
    6.25% {
      transform: translateX(350%) translateY(-5.8px);
    }
    12.5% {
      transform: translateX(300%) translateY(-10.6px);
    }
    18.75% {
      transform: translateX(250%) translateY(-13.9px);
    }
    25% {
      transform: translateX(200%) translateY(-15px);
    }
    31.25% {
      transform: translateX(150%) translateY(-13.9px);
    }
    37.5% {
      transform: translateX(100%) translateY(-10.6px);
    }
    43.75% {
      transform: translateX(60%) translateY(-5.8px);
    }
    50% {
      transform: translateX(30%) translateY(0);
    }
    56.25% {
      transform: translateX(15%) translateY(5.8px);
    }
    62.5% {
      transform: translateX(8%) translateY(10.6px);
    }
    68.75% {
      transform: translateX(4%) translateY(13.9px);
    }
    75% {
      transform: translateX(2%) translateY(15px);
    }
    81.25% {
      transform: translateX(1%) translateY(13.9px);
    }
    87.5% {
      transform: translateX(0.5%) translateY(10.6px);
    }
    93.75% {
      transform: translateX(0.25%) translateY(5.8px);
    }
    100% {
      transform: translateX(0) translateY(0);
    }
  }

  @keyframes hoverUpDown {
    0%,
    100% {
      transform: translateX(0) translateY(0);
    }
    50% {
      transform: translateX(0) translateY(-15px);
    }
  }

  // Rollercoaster animation for dragon container - adapted from smooth roller coaster pattern
  // Based on: https://github.com/blank-yt/Smooth-Roller-Coaster-Loading-Animation
  @keyframes rollercoasterLoop {
    0% {
      // Start at exact bottom left corner of screen
      transform: translateX(-100vw) translateY(100vh) rotate(0deg);
    }
    12% {
      // Fly in at 45-degree angle (equal X and Y movement for true 45°)
      transform: translateX(-60vw) translateY(60vh) rotate(0deg);
    }
    25% {
      // Continue 45-degree approach
      transform: translateX(-20vw) translateY(20vh) rotate(0deg);
    }
    30% {
      // Reach loop position
      transform: translateX(0%) translateY(-20vh) rotate(0deg);
    }
    60% {
      // Stay at loop position and rotate
      transform: translateX(0%) translateY(-20vh) rotate(-360deg);
    }
    70% {
      // Exit loop
      transform: translateX(5%) translateY(-10vh) rotate(-360deg);
    }
    100% {
      // Final position
      transform: translateX(0) translateY(0) rotate(-360deg);
    }
  }
</style>

<script>
  // Load animated images immediately after dragon animation completes (2s delay + 3.5s duration = 5.5s)
  function initAnimatedImages() {
    const shieldImg = document.querySelector(
      '.home-page__shield[data-src]'
    ) as HTMLImageElement | null;
    const spellAttackImg = document.querySelector(
      '.home-page__spell-attack[data-src]'
    ) as HTMLImageElement | null;

    if (!shieldImg || !spellAttackImg) return;

    // Dragon animation completes at 5.5s (2s delay + 3.5s duration)
    const dragonAnimationComplete = 5500;

    // Preload both images first
    const shieldPreload = new Image();
    const spellAttackPreload = new Image();
    
    let shieldLoaded = false;
    let spellAttackLoaded = false;

    const startAnimations = () => {
      // Use requestAnimationFrame to ensure both animations start in the exact same frame
      requestAnimationFrame(() => {
        // Set both src attributes synchronously to start animations at the same time
        if (shieldImg.dataset.src) {
          shieldImg.src = shieldImg.dataset.src;
          shieldImg.removeAttribute('data-src');
        }
        if (spellAttackImg.dataset.src) {
          spellAttackImg.src = spellAttackImg.dataset.src;
          spellAttackImg.removeAttribute('data-src');
        }
      });
    };

    shieldPreload.onload = () => {
      shieldLoaded = true;
      if (shieldLoaded && spellAttackLoaded) {
        startAnimations();
      }
    };

    spellAttackPreload.onload = () => {
      spellAttackLoaded = true;
      if (shieldLoaded && spellAttackLoaded) {
        startAnimations();
      }
    };

    // Handle errors - start anyway if one fails
    shieldPreload.onerror = () => {
      shieldLoaded = true;
      if (shieldLoaded && spellAttackLoaded) {
        startAnimations();
      }
    };

    spellAttackPreload.onerror = () => {
      spellAttackLoaded = true;
      if (shieldLoaded && spellAttackLoaded) {
        startAnimations();
      }
    };

    setTimeout(() => {
      // Start preloading both images
      if (shieldImg.dataset.src) {
        shieldPreload.src = shieldImg.dataset.src;
      }
      if (spellAttackImg.dataset.src) {
        spellAttackPreload.src = spellAttackImg.dataset.src;
      }
    }, dragonAnimationComplete);
  }

  // Run on page load and after view transitions
  document.addEventListener('astro:page-load', initAnimatedImages);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimatedImages);
  } else {
    initAnimatedImages();
  }
</script>
