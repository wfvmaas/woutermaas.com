---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const art = await getCollection("art")
---

<BaseLayout title="Art">
  <div class="art-page">
    <div class="page-header">
      <h1>Art</h1>
      <img
        src="/doodles/artist_did_not_submit_artwork.svg"
        alt="Art"
        class="header-illustration"
      />
    </div>
    <div class="art-grid">
      {
        art.length > 0 ? (
          art.map((item) => (
            <a href={`/art/${item.slug}`} class="art-item">
              <div class="art-image">
                {/* Image placeholder */}
                <div class="placeholder">
                  <span>+</span>
                </div>
              </div>
              <h2>{item.data.title}</h2>
            </a>
          ))
        ) : (
          <p class="empty-state">Gallery coming soon...</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .art-page {
    .container();
    padding-top: @spacing-20;
    padding-bottom: @spacing-20;

    .page-header {
      text-align: center;
      margin-bottom: @spacing-20;

      h1 {
        font-size: @text-6xl;
        font-weight: 700;
        letter-spacing: -0.05em;
        margin: 0 0 @spacing-8 0;

        @media (min-width: @screen-md) {
          font-size: @text-8xl;
        }
      }

      .header-illustration {
        margin: 0 auto;
        width: 100%;
        max-width: 64rem;
      }
    }

    .art-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: @spacing-8;

      @media (min-width: @screen-sm) {
        grid-template-columns: repeat(2, 1fr);
      }

      @media (min-width: @screen-lg) {
        grid-template-columns: repeat(3, 1fr);
      }

      .art-item {
        display: block;

        .art-image {
          aspect-ratio: 1;
          background: @color-gray-100;
          border-radius: 0.5rem;
          overflow: hidden;
          margin-bottom: @spacing-4;

          .placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: @color-gray-300;

            span {
              font-size: @text-4xl;
              font-weight: 300;
            }
          }
        }

        h2 {
          font-size: @text-xl;
          font-weight: 500;
          margin: 0;
        }
      }
    }

    .empty-state {
      text-align: center;
      color: @color-gray-500;
      font-style: italic;
    }
  }
</style>
