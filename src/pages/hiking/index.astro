---
import { getCollection, getEntry } from "astro:content"
import OverviewPageLayout from "../../layouts/OverviewPageLayout.astro"

const overview = await getEntry("overviews", "hiking")
if (!overview) throw new Error("Hiking overview not found")

// Fetch both full projects and overview-only entries
const fullProjects = await getCollection("hiking")
const overviewEntries = await getCollection("overviews", ({ data }) => {
  return data.categories?.includes("hiking")
})

// Merge and sort by order
const allProjects = [...fullProjects, ...overviewEntries].sort((a, b) => {
  const orderA = a.data.order ?? 99
  const orderB = b.data.order ?? 99
  if (orderA !== orderB) return orderA - orderB
  return a.data.title.localeCompare(b.data.title)
})
---

<OverviewPageLayout
  category="hiking"
  title={overview.data.title}
  introText={overview.data.introText ?? ""}
  heroImage={overview.data.heroImage ?? ""}
  projects={allProjects}
/>
