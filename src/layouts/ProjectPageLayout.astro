---
interface Props {
  title: string
  abstract?: string
  heroImage?: string
}

const { title, abstract, heroImage } = Astro.props

import BaseLayout from "./BaseLayout.astro"
import ScrollIndicator from "../components/ScrollIndicator.astro"
---

<BaseLayout title={title}>
  <div class="project-page outer-container">
    <!-- Header Section -->
    <div class="project-header allow-menu">
      <div class="header-content">
        <div class="text-content">
          <h1>{title}</h1>
          {abstract && <p class="abstract">{abstract}</p>}
        </div>
        {
          heroImage && (
            <div class="hero-image hero-image-desktop">
              <img
                src={typeof heroImage === "string" ? heroImage : heroImage}
                alt={title}
              />
            </div>
          )
        }
      </div>
      <div class="scroll-indicator-wrapper">
        <ScrollIndicator target="#project-content" />
      </div>
    </div>

    {
      heroImage && (
        <div class="hero-image hero-image-mobile">
          <img
            src={typeof heroImage === "string" ? heroImage : heroImage}
            alt={title}
          />
        </div>
      )
    }

    <!-- Content Section -->
    <article
      class="project-content content-container allow-menu"
      id="project-content"
    >
      <slot />
    </article>
  </div>
</BaseLayout>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .project-page {
    min-height: 100vh;
    // Padding is now handled by outer-container

    .project-header {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      max-width: 1600px;
      margin: 0 auto;
      padding-top: @spacing-24;
      padding-bottom: @spacing-24;

      .header-content {
        display: flex;
        flex-direction: column;
        gap: @spacing-8;
        justify-content: space-between;

        @media (max-width: @screen-md) {
          justify-content: flex-end;
          min-height: 70vh;
          gap: 0;
        }
        @media (min-width: @screen-lg) {
          flex-direction: row;
          gap: @spacing-16;
          align-items: flex-start;
        }

        .text-content {
          flex: 1;
          gap: 40vh;
          display: flex;
          flex-direction: column;

          @media (max-width: @screen-md) {
            gap: 0;
            justify-content: flex-end;
          }
          @media (min-width: @screen-lg) {
            max-width: 550px;
          }

          h1 {
            font-size: @text-4xl;
            font-weight: 700;
            line-height: 1.1;
            margin: 0 0 @spacing-6 0;

            @media (min-width: @screen-md) {
              font-size: @text-5xl;
            }

            @media (min-width: @screen-lg) {
              font-size: @text-8xl;
            }
          }

          .abstract {
            font-size: @text-base;
            line-height: 1.6;
            color: @color-gray-900;
            margin: 0;
            max-width: 60ch;

            @media (min-width: @screen-md) {
              font-size: @text-lg;
            }

            @media (min-width: @screen-lg) {
              font-size: @text-xl;
            }
          }
        }

        .hero-image {
          border-radius: @radius-lg;
          overflow: hidden;
          background: @color-gray-100;

          img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
            margin: auto;
          }
        }

        .hero-image-desktop {
          display: none;

          @media (min-width: @screen-lg) {
            display: block;
            align-self: center;
            max-width: 50%;
          }
        }
      }

      .scroll-indicator-wrapper {
        position: absolute;
        bottom: @spacing-8;
        left: 50%;
        transform: translateX(-50%);

        @media (min-width: @screen-md) {
          bottom: @spacing-12;
        }
      }
    }

    .hero-image-mobile {
      display: block;
      border-radius: @radius-lg;
      overflow: hidden;
      background: @color-gray-100;
      margin: @spacing-8 @spacing-6;

      @media (min-width: @screen-lg) {
        display: none;
      }

      img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
      }
    }

    .project-content {
      max-width: 800px;
      margin: 0 auto;
      padding-top: @spacing-16;
      padding-bottom: @spacing-32;

      // Markdown content styles
      :global(h1),
      :global(h2),
      :global(h3),
      :global(h4),
      :global(h5),
      :global(h6) {
        font-weight: 700;
        line-height: 1.3;
        margin-top: @spacing-12;
        margin-bottom: @spacing-6;

        &:first-child {
          margin-top: 0;
        }
      }

      :global(h1) {
        font-size: @text-4xl;
      }

      :global(h2) {
        font-size: @text-3xl;
      }

      :global(h3) {
        font-size: @text-2xl;
      }

      :global(h4) {
        font-size: @text-xl;
      }

      :global(p) {
        font-size: @text-base;
        line-height: 1.7;
        margin-bottom: @spacing-6;
        color: @color-gray-900;

        @media (min-width: @screen-md) {
          font-size: @text-lg;
        }
      }

      :global(img) {
        width: 100%;
        height: auto;
        border-radius: @radius-lg;
        margin: @spacing-8 0;
      }

      :global(ul),
      :global(ol) {
        margin: @spacing-6 0;
        padding-left: @spacing-8;

        li {
          margin-bottom: @spacing-3;
          line-height: 1.7;
        }
      }

      :global(blockquote) {
        border-left: 4px solid @color-gray-300;
        padding-left: @spacing-6;
        margin: @spacing-8 0;
        font-style: italic;
        color: @color-gray-700;
      }

      :global(code) {
        background: @color-gray-100;
        padding: 0.2em 0.4em;
        border-radius: @radius-sm;
        font-size: 0.9em;
        font-family: monospace;
      }

      :global(pre) {
        background: @color-gray-100;
        padding: @spacing-6;
        border-radius: @radius-md;
        overflow-x: auto;
        margin: @spacing-8 0;

        code {
          background: none;
          padding: 0;
        }
      }

      :global(a) {
        color: @color-blue-600;
        text-decoration: underline;
        .transition(color);

        &:hover {
          color: @color-blue-500;
        }
      }

      :global(hr) {
        border: none;
        border-top: 1px solid @color-gray-200;
        margin: @spacing-12 0;
      }
    }
  }
</style>
