---
interface Props {
  category: string
  title: string
  introText: string
  heroImage: string
  projects: any[]
}

const { category, title, introText, heroImage, projects } = Astro.props

import BaseLayout from "./BaseLayout.astro"
import ScrollIndicator from "../components/ScrollIndicator.astro"

// Helper to check if project has a detail page (not overview-only)
const hasDetailPage = (project: any) => {
  return project.collection === category
}

// Helper to strip numerical prefix from slug
const cleanSlug = (slug: string) => {
  return slug.replace(/^\d+\.?/, "")
}
---

<BaseLayout title={title}>
  <div class="layout-wrapper">
    <div class="overview-page">
      <div class="page-header">
        <div class="header-content">
          <div class="illustration-container">
            <img src={heroImage} alt={title} class="header-illustration" />
          </div>
          <div class="text-content">
            <h1>{title}</h1>
            <p class="intro-text">
              {introText}
            </p>
          </div>
        </div>
      </div>

      <div class="projects-list" id="projects-list">
        {
          projects.map((project) => (
            <article class="project-item">
              <h2 class="project-title">{project.data.title}</h2>

              {project.data.heroImage && (
                <div class="project-image">
                  <img
                    src={
                      typeof project.data.heroImage === "string"
                        ? project.data.heroImage
                        : project.data.heroImage.src
                    }
                    alt={project.data.title}
                    loading="lazy"
                  />
                </div>
              )}

              <div class="project-info">
                <p class="abstract">
                  {project.data.abstract || project.data.title}
                </p>
                {hasDetailPage(project) && (
                  <a
                    href={`/${category}/${cleanSlug(project.slug)}`}
                    class="learn-more-btn"
                  >
                    Learn more
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="scroll-indicator-wrapper">
      <ScrollIndicator scale={1.5} target="#projects-list" />
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .layout-wrapper {
    position: relative;
    width: 100%;
  }

  .scroll-indicator-wrapper {
    position: absolute;
    left: 50%;
    top: 90vh;
    transform: translateX(-50%);
    width: fit-content;
    z-index: 20;
  }

  .overview-page {
    padding-top: 0;
    padding-bottom: @spacing-24;
    max-width: 600px;
    margin: 0 auto;
    padding-left: @spacing-6;
    padding-right: 80px; // Space for wizard menu on mobile

    @media (min-width: @screen-lg) {
      max-width: @container-max-width;
      padding-right: @spacing-6; // Reset on desktop since wizard is fixed
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .page-header {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: @spacing-6 0;

      @media (max-width: @screen-md) {
        align-items: flex-end;
        padding-bottom: 15vh;
        margin-bottom: 4rem;
      }

      .header-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @spacing-8;
        text-align: center;
        width: 100%;
        max-width: 500px;

        @media (min-width: @screen-lg) {
          flex-direction: row-reverse;
          justify-content: space-between;
          text-align: left;
          gap: @spacing-16;
          max-width: 1200px;
          padding: 0 @spacing-16;
        }

        .illustration-container {
          width: 100%;
          max-width: 250px;

          @media (min-width: @screen-lg) {
            max-width: 400px;
          }

          img {
            width: 100%;
            height: auto;
          }
        }

        .text-content {
          flex: 1;

          h1 {
            font-size: @text-5xl;
            font-weight: 700;
            margin: 0 0 @spacing-6 0;
            text-align: left;

            @media (min-width: @screen-lg) {
              font-size: @text-8xl;
              margin-bottom: @spacing-8;
            }
          }

          .intro-text {
            font-size: @text-lg;
            line-height: 1.4;
            color: @color-gray-900;
            max-width: 40ch;
            margin: 0 auto;
            text-align: left;

            @media (min-width: @screen-lg) {
              font-size: @text-xl;
              margin: 0;
            }
          }
        }
      }
    }

    .projects-list {
      display: flex;
      flex-direction: column;
      gap: @spacing-24;
      max-width: 900px;
      margin: 0 auto;

      @media (min-width: @screen-lg) {
        padding: @spacing-24 @spacing-16;
        gap: @spacing-32;
      }

      .project-item {
        display: flex;
        flex-direction: column;
        gap: @spacing-6;

        .project-title {
          font-size: @text-2xl;
          font-weight: 600;
          margin: 0 0 @spacing-4 0;

          @media (min-width: @screen-lg) {
            font-size: @text-4xl;
          }
        }

        .project-image {
          width: 100%;
          overflow: hidden;
          background: @color-gray-100;
          margin-bottom: @spacing-4;

          img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
          }
        }

        .project-info {
          display: flex;
          flex-direction: column;
          gap: @spacing-6;

          .abstract {
            font-size: @text-base;
            line-height: 1.6;
            color: @color-gray-800;
            margin: 0;

            @media (min-width: @screen-lg) {
              font-size: @text-lg;
            }
          }

          .learn-more-btn {
            display: block;
            width: 100%;
            padding: @spacing-3 @spacing-6;
            margin-top: @spacing-4;
            margin-left: auto;
            margin-right: auto;
            background: transparent;
            color: @color-black;
            border: 2px solid @color-black;
            border-radius: @radius-sm;
            text-align: center;
            font-weight: 500;
            text-decoration: none;
            transition: background-color 0.2s ease;

            @media (min-width: @screen-lg) {
              max-width: 400px;
            }

            &:hover {
              background: @color-gray-100;
            }
          }
        }
      }
    }
  }
</style>
