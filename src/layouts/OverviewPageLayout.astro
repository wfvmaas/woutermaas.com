---
import { getImage } from 'astro:assets';

interface Props {
  category: string;
  title: string;
  introText: string;
  heroImage: string;
  projects: any[];
}

const { category, title, introText, heroImage, projects } = Astro.props;

import BaseLayout from './BaseLayout.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';

// Helper to check if project has a detail page (not overview-only)
const hasDetailPage = (project: any) => {
  return project.collection === category;
};

// Helper to check if item is an abstract
const isAbstract = (item: any) => {
  return item.collection === 'abstracts';
};

// Process project images before rendering
// For content collection images, use .src directly (getImage may not be needed)
// Abstracts use 'img_url', regular projects use 'heroImage'
const projectsWithProcessedImages = projects.map((project) => {
  const isAbstractItem = isAbstract(project);
  const imageField = isAbstractItem ? 'img_url' : 'heroImage';
  const imageValue = project.data[imageField];

  if (imageValue && typeof imageValue !== 'string') {
    return {
      ...project,
      data: {
        ...project.data,
        [imageField]: (imageValue as any).src || '',
      },
    };
  }
  return project;
});
---

<BaseLayout title={title}>
  <div class="overview-page-wrapper layout-outer-container">
    <div class="overview-page layout-content-container">
      <div class="overview-page__hero">
        <div class="overview-page__hero-content">
          <div class="overview-page__illustration-container">
            <img
              src={heroImage}
              alt={title}
              class="overview-page__hero-illustration"
            />
          </div>
          <div class="overview-page__text-content">
            <h1>{title}</h1>
            <p class="overview-page__intro-text">
              {introText}
            </p>
          </div>
        </div>
      </div>

      <div
        class="overview-page__projects-list"
        id="overview-page__projects-list"
      >
        {
          projectsWithProcessedImages.map((project) => (
            <article class="overview-page__project-item">
              <h2 class="overview-page__project-title">{project.data.title}</h2>

              {(isAbstract(project)
                ? project.data.img_url
                : project.data.heroImage) && (
                <div class="overview-page__project-image">
                  <img
                    src={
                      isAbstract(project)
                        ? project.data.img_url
                        : project.data.heroImage
                    }
                    alt={project.data.title}
                    loading="lazy"
                  />
                </div>
              )}

              <div class="overview-page__project-info">
                <p class="overview-page__abstract">
                  {project.data.abstract || project.data.title}
                </p>
                {hasDetailPage(project) && (
                  <a
                    href={`/${category}/${project.slug}`}
                    class="overview-page__learn-more-btn"
                  >
                    Learn more
                  </a>
                )}
                {isAbstract(project) && project.data.cta_link && (
                  <a
                    href={project.data.cta_link}
                    class="overview-page__learn-more-btn"
                    target={
                      project.data.cta_link.startsWith('http')
                        ? '_blank'
                        : undefined
                    }
                    rel={
                      project.data.cta_link.startsWith('http')
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {project.data.cta_label || 'Learn more'}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="overview-page__scroll-indicator-wrapper">
      <ScrollIndicator scale={1.5} target="#overview-page__projects-list" />
    </div>
  </div>
</BaseLayout>

<style lang="less">
  @import '../styles/variables.less';
  @import '../styles/mixins.less';
  @import '../styles/global.less';

  .overview-page-wrapper {
    position: relative;
    width: 100%;
    // Padding handled by layout-outer-container
  }

  .overview-page {
    padding-top: 0;
    padding-bottom: @spacing-24;
    margin: 0 auto;

    @media (min-width: @screen-lg) {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    &__hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: @spacing-6 0;

      @media (max-width: (@screen-lg - 1px)) {
        align-items: flex-end;
        padding-bottom: 15vh;
        margin-bottom: 4rem;
      }
    }

    &__hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: @spacing-8;
      text-align: center;
      width: 100%;
      max-width: 500px;

      @media (min-width: @screen-lg) {
        flex-direction: row-reverse;
        justify-content: space-between;
        align-items: flex-start;
        text-align: left;
        gap: @spacing-16;
        max-width: 100%;
        width: 100%;
      }
    }

    &__illustration-container {
      width: 100%;
      flex-shrink: 0;
      margin-right: @spacing-4;

      @media (min-width: @screen-sm) {
        min-width: 250px;
      }
      @media (min-width: @screen-lg) {
        max-width: 400px;
        width: 400px;
      }

      img {
        width: 100%;
        height: auto;
      }
    }

    &__text-content {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;

      @media (min-width: @screen-lg) {
        max-width: 600px;
        min-width: 0;
      }

      h1 {
        font-size: @text-5xl;
        font-weight: 700;
        margin: 0 0 @spacing-6 0;
        text-align: left;
        width: 100%;

        @media (min-width: @screen-lg) {
          font-size: @text-8xl;
          margin-bottom: @spacing-8;
        }
      }
    }

    &__intro-text {
      font-size: @text-lg;
      line-height: 1.4;
      color: @color-gray-900;
      max-width: 40ch;
      margin: 0;
      text-align: left;
      width: 100%;

      @media (min-width: @screen-lg) {
        font-size: @text-xl;
        margin: 0;
        max-width: 100%;
      }
    }

    &__projects-list {
      display: flex;
      flex-direction: column;
      gap: @spacing-24;
      margin: 0 auto;

      @media (min-width: @screen-lg) {
        padding: @spacing-24 0;
        gap: @spacing-32;
      }
    }

    &__project-item {
      display: flex;
      flex-direction: column;
      gap: @spacing-6;
    }

    &__project-title {
      font-size: @text-2xl;
      font-weight: 600;
      margin: 0 0 @spacing-4 0;

      @media (min-width: @screen-lg) {
        font-size: @text-4xl;
      }
    }

    &__project-image {
      width: 100%;
      overflow: hidden;
      background: @color-gray-100;
      margin-bottom: @spacing-4;

      img {
        width: 100%;
        height: 100%;
        max-height: 500px;
        display: block;
        object-fit: cover;
        object-position: top;
      }
    }

    &__project-info {
      display: flex;
      flex-direction: column;
      gap: @spacing-6;
    }

    &__abstract {
      font-size: @text-base;
      line-height: 1.6;
      color: @color-gray-800;
      margin: 0;

      @media (min-width: @screen-lg) {
        font-size: @text-lg;
      }
    }

    &__learn-more-btn {
      display: block;
      width: 100%;
      max-width: 350px;
      padding: @spacing-3 @spacing-6;
      margin-top: @spacing-4;
      margin-left: auto;
      margin-right: auto;
      background: transparent;
      color: @color-black;
      border: 2px solid @color-black;
      border-radius: @radius-md;
      text-align: center;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.5s ease-in-out;

      @media (min-width: @screen-lg) {
        max-width: 400px;
      }

      &:hover {
        background: @color-black;
        color: @color-white;
      }
    }

    &__scroll-indicator-wrapper {
      position: absolute;
      left: 50%;
      top: 90vh;
      transform: translateX(-50%);
      width: fit-content;

      @media (min-width: @screen-lg) {
        top: 85vh;
      }
    }
  }
</style>
