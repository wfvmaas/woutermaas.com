---
interface Props {
  title: string
  hero_text?: string
  heroImage?: string
}

const { title, hero_text, heroImage } = Astro.props

import BaseLayout from "./BaseLayout.astro"
import ScrollIndicator from "../components/ScrollIndicator.astro"
---

<BaseLayout title={title}>
  <div class="detail-page layout-outer-container">
    <!-- Header Section -->
    <div class="detail-page__header layout-allow-menu">
      <div class={`detail-page__header-content ${!heroImage ? 'detail-page__header-content--no-hero-image' : ''}`}>
        {
          heroImage && (
            <div class="detail-page__hero-image detail-page__hero-image--mobile">
              <img
                src={typeof heroImage === "string" ? heroImage : heroImage}
                alt={title}
              />
            </div>
          )
        }
        <div class="detail-page__text-content">
          <h1>{title}</h1>
          {hero_text && <p class="detail-page__abstract">{hero_text}</p>}
        </div>
        {
          heroImage && (
            <div class="detail-page__hero-image detail-page__hero-image--desktop">
              <img
                src={typeof heroImage === "string" ? heroImage : heroImage}
                alt={title} 
              />
            </div>
          )
        }
      </div>
    </div>

    <div class="detail-page__scroll-indicator-wrapper">
      <ScrollIndicator scale={1.5} target="#detail-page__content" />
    </div>

    <!-- Content Section -->
    <article
      class="detail-page__content layout-content-container layout-allow-menu"
      id="detail-page__content"
    >
      <slot />
    </article>
  </div>
</BaseLayout>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .detail-page {
    min-height: 100vh;
    // Padding is now handled by layout-outer-container

    &__header {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      max-width: 1600px;
      margin: 0 auto;
      padding-top: calc(@spacing-24 * 1.5);
      padding-bottom: @spacing-24;

      @media (max-width: (@screen-lg - 1px)) {
        align-items: flex-end;
        padding-bottom: 15vh;
        margin-bottom: 4rem;
      }
    }

    &__header-content {
      display: flex;
      flex-direction: column;
      gap: @spacing-8;
      justify-content: space-between;

      @media (max-width: (@screen-lg - 1px)) {
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 500px;
        gap: @spacing-4;
      }
      @media (min-width: @screen-lg) {
        flex-direction: row;
        gap: @spacing-16;
        align-items: flex-start;
      }

      &--no-hero-image {
        @media (min-width: @screen-lg) {
          flex-direction: column;
          align-items: center;
          justify-content: center;
        }

        .detail-page__text-content {
          @media (min-width: @screen-lg) {
            gap: @spacing-8;
            max-width: 800px;
            width: 100%;
            justify-content: center;
          }
        }
      }
    }

    &__hero-image {
      border-radius: @radius-lg;
      overflow: hidden;
      background: @color-gray-100;

      img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        margin: auto;
      }

      &--mobile {
        display: block;
        width: 100%;
        margin-bottom: @spacing-4;

        @media (min-width: @screen-lg) {
          display: none;
        }
      }

      &--desktop {
        display: none;

        @media (min-width: @screen-lg) {
          display: block;
          align-self: center;
          max-width: 50%;
        }

        @media (min-width: @screen-lg) and (max-width: (@screen-xl - 1px)) {
          min-width: 300px;
          margin-left: -@spacing-16;
          z-index: 1;
        }
      }
    }

    &__text-content {
      flex: 1;
      gap: 40vh;
      display: flex;
      flex-direction: column;

      @media (max-width: (@screen-lg - 1px)) {
        gap: 0;
        justify-content: flex-end;
        width: 100%;
      }
      @media (min-width: @screen-lg) {
        max-width: 550px;
      }

      h1 {
        font-size: @text-4xl;
        font-weight: 700;
        line-height: 1.1;
        margin: 0 0 @spacing-6 0;

        @media (max-width: (@screen-lg - 1px)) {
          font-size: @text-5xl;
          text-align: left;
        }

        @media (min-width: @screen-lg) {
          font-size: @text-8xl;
          margin-bottom: @spacing-8;
        }
      }
    }

    &__abstract {
      font-size: @text-base;
      line-height: 1.6;
      color: @color-gray-900;
      margin: 0;
      max-width: 60ch;

      @media (max-width: (@screen-lg - 1px)) {
        font-size: @text-lg;
        line-height: 1.4;
        max-width: 40ch;
        text-align: left;
      }

      @media (min-width: @screen-lg) {
        font-size: @text-xl;
      }
    }

    &__scroll-indicator-wrapper {
      position: absolute;
      left: 50%;
      top: 90vh;
      transform: translateX(-50%);
      width: fit-content;
      z-index: 20;
    }

    &__content {
      max-width: 800px;
      margin: 0 auto;
      padding-top: @spacing-16;
      padding-bottom: @spacing-32;

      // Markdown content styles
      :global(h1),
      :global(h2),
      :global(h3),
      :global(h4),
      :global(h5),
      :global(h6) {
        font-weight: 700;
        line-height: 1.3;
        margin-top: @spacing-12;
        margin-bottom: @spacing-6;

        &:first-child {
          margin-top: 0;
        }
      }

      :global(h1) {
        font-size: @text-4xl;
      }

      :global(h2) {
        font-size: @text-3xl;
      }

      :global(h3) {
        font-size: @text-2xl;
      }

      :global(h4) {
        font-size: @text-xl;
      }

      :global(p) {
        font-size: @text-base;
        line-height: 1.7;
        margin-bottom: @spacing-6;
        color: @color-gray-900;

        @media (min-width: @screen-lg) {
          font-size: @text-lg;
        }
      }

      :global(img) {
        width: 100%;
        height: auto;
        border-radius: @radius-lg;
        margin: @spacing-8 0;
      }

      :global(ul),
      :global(ol) {
        margin: @spacing-6 0;
        padding-left: @spacing-8;

        li {
          margin-bottom: @spacing-3;
          line-height: 1.7;
        }
      }

      :global(blockquote) {
        border-left: 4px solid @color-gray-300;
        padding-left: @spacing-6;
        margin: @spacing-8 0;
        font-style: italic;
        color: @color-gray-700;
      }

      :global(code) {
        background: @color-gray-100;
        padding: 0.2em 0.4em;
        border-radius: @radius-sm;
        font-size: 0.9em;
        font-family: monospace;
      }

      :global(pre) {
        background: @color-gray-100;
        padding: @spacing-6;
        border-radius: @radius-md;
        overflow-x: auto;
        margin: @spacing-8 0;

        code {
          background: none;
          padding: 0;
        }
      }

      :global(a) {
        color: @color-blue-600;
        text-decoration: underline;
        .transition(color);

        &:hover {
          color: @color-blue-500;
        }
      }

      :global(hr) {
        border: none;
        border-top: 1px solid @color-gray-200;
        margin: @spacing-12 0;
      }
    }
  }
</style>
