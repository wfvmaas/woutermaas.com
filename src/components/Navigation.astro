---
const links = [
  { href: "/software", label: "Software" },
  { href: "/storytelling", label: "Storytelling" },
  { href: "/philosophy", label: "Philosophy" },
  { href: "/art", label: "Art" },
  { href: "/hiking", label: "Hiking" },
  { href: "/cv", label: "Serious CV" },
  { href: "/contact", label: "Contact" },
]
---

<nav class="main-nav" id="main-nav">
  <div class="main-nav__container">
    <!-- Logo -->
    <div class="main-nav__logo">
      <a href="/"> WOUTER MAAS </a>
    </div>

    <!-- Desktop Menu -->
    <div class="main-nav__desktop-menu">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <!-- Mobile Menu Button -->
    <div class="main-nav__mobile-menu-btn-wrapper">
      <button id="mobile-menu-btn" class="main-nav__mobile-menu-btn">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu">
  <button id="close-menu-btn" class="mobile-menu__close-btn">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</div>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid @color-gray-100;
    .transition();

    &__container {
      .container();
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 5rem;
    }

    &__logo {
      flex-shrink: 0;
      display: flex;
      align-items: center;

      a {
        font-size: @text-2xl;
        font-weight: 700;
        letter-spacing: -0.05em;
        .transition(opacity);

        &:hover {
          opacity: 0.7;
        }
      }
    }

    &__desktop-menu {
      display: none;

      @media (min-width: @screen-md) {
        display: flex;
        gap: @spacing-8;
        align-items: center;
      }

      a {
        font-size: @text-sm;
        font-weight: 500;
        color: @color-gray-900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        .transition(color);

        &:hover {
          color: @color-gray-500;
        }
      }
    }

    &__mobile-menu-btn-wrapper {
      // Wrapper for mobile menu button
    }

    &__mobile-menu-btn {
      display: flex;
      align-items: center;
      padding: @spacing-2;
      color: @color-gray-900;
      background: none;
      border: none;
      cursor: pointer;
      .transition(color);

      @media (min-width: @screen-md) {
        display: none;
      }

      &:hover {
        color: @color-gray-600;
      }

      &:focus {
        outline: none;
      }

      svg {
        height: 1.5rem;
        width: 1.5rem;
      }
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: white;
    transform: translateX(100%);
    .transition(transform);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: @spacing-8;

    @media (min-width: @screen-md) {
      display: none;
    }

    &--open {
      transform: translateX(0);
    }

    &__close-btn {
      position: absolute;
      top: @spacing-6;
      right: @spacing-6;
      color: @color-gray-900;
      background: none;
      border: none;
      padding: @spacing-2;
      cursor: pointer;
      .transition(color);

      &:hover {
        color: @color-gray-600;
      }

      svg {
        height: 2rem;
        width: 2rem;
      }
    }

    a {
      font-size: @text-2xl;
      font-weight: 300;
      color: @color-gray-900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      .transition(color);

      &:hover {
        color: @color-gray-500;
      }
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn")
  const closeMenuBtn = document.getElementById("close-menu-btn")
  const mobileMenu = document.getElementById("mobile-menu")

  function toggleMenu() {
    mobileMenu?.classList.toggle("mobile-menu--open")
    document.body.classList.toggle("overflow-hidden")
  }

  mobileMenuBtn?.addEventListener("click", toggleMenu)
  closeMenuBtn?.addEventListener("click", toggleMenu)
</script>
