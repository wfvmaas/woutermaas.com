---
const links = [
  { href: '/software', label: 'Software' },
  { href: '/storytelling', label: 'Storytelling' },
  { href: '/philosophy', label: 'Philosophy' },
  { href: '/art', label: 'Art' },
  { href: '/hiking', label: 'Hiking' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="main-nav" id="main-nav">
  <div class="main-nav__container">
    <!-- Logo -->
    <div class="main-nav__logo">
      <a href="/">
        <svg
          version="1.1"
          id="logo"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          x="0px"
          y="0px"
          viewBox="0 0 728.6 396.5"
          class="main-nav__logo-img"
        >
          <path
            class="logo"
            d="M630.4,0l-39.5,165.8c-8.8,39.3-19.9,99-19.9,99h-1.1c0,0-10-54.8-18.8-95.1L513.8,0l-92.3,0l-39.3,164.8
	c-0.4,1.6-0.8,3.3-1.1,5.1l0,0c-8.8,39.7-17,84.3-17,84.6c0,0,0,0,0,0c-3.1-18.8-10-59.1-16.6-87.5L305.4,0h-90.7l-37.1,169.8
	c-8.9,39.8-19.4,94-19.4,94h-1.1c0,0-9.4-59.7-18.3-97.9L99,0H0l108.7,396.5h95.6l41.8-190.7c3.3-15.7,6.6-34.1,9.1-48.5l55.3,214
	l5.5,25.3h0h1h96.3l10.9-49.7l49.1-189.2c2.6,14.5,6.1,33.2,9.7,49.1l41.5,189.7h95.7L728.6,0L630.4,0L630.4,0z"
          />
        </svg>
        <span class="main-nav__logo-text">WOUTER MAAS</span>
      </a>
    </div>

    <!-- Desktop Menu -->
    <div class="main-nav__desktop-menu">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <!-- Mobile Menu Button -->
    <div class="main-nav__mobile-menu-btn-wrapper">
      <button id="mobile-menu-btn" class="main-nav__mobile-menu-btn">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu">
  <button id="close-menu-btn" class="mobile-menu__close-btn">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</div>

<style lang="less">
  @import '../styles/variables.less';
  @import '../styles/mixins.less';

  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid @color-gray-100;
    .transition();

    &__container {
      .container();
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 5rem;
    }

    &__logo {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      a {
        display: flex;
        align-items: center;
        gap: @spacing-3;
        .transition(opacity);

        &:hover {
          opacity: 0.7;
        }
      }

      &-img {
        display: none;
        height: 2rem;
        width: auto;

        @media (min-width: @screen-md) {
          display: block;
        }

        :global(.logo) {
          fill: @color-black;
        }
      }

      &-text {
        font-size: @text-2xl;
        font-weight: 700;
        letter-spacing: -0.05em;

        @media (min-width: @screen-md) {
          display: none;
        }
      }
    }

    &__desktop-menu {
      display: none;

      @media (min-width: @screen-md) {
        display: flex;
        gap: @spacing-8;
        align-items: center;
      }

      a {
        font-size: @text-sm;
        font-weight: 500;
        color: @color-gray-900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        .transition(color);

        &:hover {
          color: @color-gray-500;
        }
      }
    }

    &__mobile-menu-btn-wrapper {
      // Wrapper for mobile menu button
    }

    &__mobile-menu-btn {
      display: flex;
      align-items: center;
      padding: @spacing-2;
      color: @color-gray-900;
      background: none;
      border: none;
      cursor: pointer;
      .transition(color);

      @media (min-width: @screen-md) {
        display: none;
      }

      &:hover {
        color: @color-gray-600;
      }

      &:focus {
        outline: none;
      }

      svg {
        height: 1.5rem;
        width: 1.5rem;
      }
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: white;
    transform: translateX(100%);
    .transition(transform);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: @spacing-8;

    @media (min-width: @screen-md) {
      display: none;
    }

    &--open {
      transform: translateX(0);
    }

    &__close-btn {
      position: absolute;
      top: @spacing-6;
      right: @spacing-6;
      color: @color-gray-900;
      background: none;
      border: none;
      padding: @spacing-2;
      cursor: pointer;
      .transition(color);

      &:hover {
        color: @color-gray-600;
      }

      svg {
        height: 2rem;
        width: 2rem;
      }
    }

    a {
      font-size: @text-2xl;
      font-weight: 300;
      color: @color-gray-900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      .transition(color);

      &:hover {
        color: @color-gray-500;
      }
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function toggleMenu() {
    mobileMenu?.classList.toggle('mobile-menu--open');
    document.body.classList.toggle('overflow-hidden');
  }

  mobileMenuBtn?.addEventListener('click', toggleMenu);
  closeMenuBtn?.addEventListener('click', toggleMenu);
</script>
