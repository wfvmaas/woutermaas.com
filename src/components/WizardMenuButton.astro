---
interface Props {
  isHomePage?: boolean
  hasMenuLabel?: boolean
}

const { isHomePage = false, hasMenuLabel = false } = Astro.props
---

<div 
  class={`wizard-menu-button ${isHomePage ? 'wizard-menu-button__home-page' : ''}`} 
  id="wizard-menu-btn" 
  data-is-home={isHomePage.toString()}
  data-has-menu-label={hasMenuLabel.toString()}
  transition:name="wizard-button"
>
  <img src="/doodles/wizard_cloud_1.svg" alt="Menu" />
  <div 
    class={`wizard-menu-button__label ${hasMenuLabel ? 'wizard-menu-button__label--visible' : ''}`} 
    data-is-home={isHomePage}
  >
    Menu
  </div>
</div>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .wizard-menu-button {
    position: sticky;
    top: 1rem;
    right: 0.5rem;
    z-index: 80;
    float: right;
    cursor: pointer;
    text-align: center;
    pointer-events: auto;
    display: block;

    // Disable pointer events and cursor when hasMenuLabel is false AND label is not visible
    &[data-has-menu-label="false"] {
      pointer-events: none;
      cursor: default;
      
      // Re-enable pointer events when label becomes visible via scroll
      &:has(.wizard-menu-button__label--visible) {
        pointer-events: auto;
        cursor: pointer;
      }
    }

    img {
      width: 4rem;
      height: auto;
      .transition(transform);
      pointer-events: none;

      @media (min-width: @screen-lg) {
        width: 6rem;
      }
    }

    &__label {
      font-size: @text-lg;
      font-weight: 500;
      margin-top: 0.25rem;
      color: @color-black;
      transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
      pointer-events: none;
    }

    // Hide label when hasMenuLabel is false (default state)
    // The --visible class will override this with !important when needed
    &[data-has-menu-label="false"] &__label {
      opacity: 0;
      transform: translateY(-0.5rem);
      pointer-events: none;
    }

    // Show label when hasMenuLabel is true
    &[data-has-menu-label="true"] &__label {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    // Show label when --visible class is added (overrides everything with !important)
    &__label--visible {
      display: block !important;
      opacity: 1 !important;
      transform: translateY(0) !important;
      pointer-events: auto;
    }
  }
</style>

<script>
  let scrollHandler: (() => void) | null = null;
  let resizeHandler: (() => void) | null = null;

  function updateLabelVisibility() {
    const wizardButton = document.getElementById("wizard-menu-btn")
    if (!wizardButton) return

    const label = wizardButton.querySelector(".wizard-menu-button__label")
    if (!label) return

    const hasMenuLabel = wizardButton.dataset.hasMenuLabel === "true"
    const isHomePage = wizardButton.dataset.isHome === "true"
    const isDesktop = window.innerWidth >= 1024

    if (hasMenuLabel) {
      // If hasMenuLabel is true, always show the label
      label.classList.add("wizard-menu-button__label--visible")
      // Enable pointer events
      wizardButton.style.pointerEvents = "auto"
      wizardButton.style.cursor = "pointer"
    } else if (!isHomePage && isDesktop) {
      // Use scroll-based visibility for non-home pages on desktop
      const scrollY = window.scrollY || window.pageYOffset
      if (scrollY > 50) {
        label.classList.add("wizard-menu-button__label--visible")
        // Enable pointer events when label is visible
        wizardButton.style.pointerEvents = "auto"
        wizardButton.style.cursor = "pointer"
      } else {
        label.classList.remove("wizard-menu-button__label--visible")
        // Disable pointer events when label is hidden
        wizardButton.style.pointerEvents = "none"
        wizardButton.style.cursor = "default"
      }
    } else {
      // If hasMenuLabel is false and not using scroll behavior, hide the label
      label.classList.remove("wizard-menu-button__label--visible")
      // Disable pointer events
      wizardButton.style.pointerEvents = "none"
      wizardButton.style.cursor = "default"
    }
  }

  function initWizardMenuButton() {
    const wizardButton = document.getElementById("wizard-menu-btn")
    if (!wizardButton) return

    const label = wizardButton.querySelector(".wizard-menu-button__label")
    if (!label) return

    const isHomePage = wizardButton.dataset.isHome === "true"
    const hasMenuLabel = wizardButton.dataset.hasMenuLabel === "true"
    const isDesktop = window.innerWidth >= 1024

    // Remove old event listeners if they exist
    if (scrollHandler) {
      window.removeEventListener("scroll", scrollHandler, { passive: true } as AddEventListenerOptions)
      scrollHandler = null
    }
    if (resizeHandler) {
      window.removeEventListener("resize", resizeHandler, { passive: true } as AddEventListenerOptions)
      resizeHandler = null
    }

    // Remove old click listener by cloning the button
    const newButton = wizardButton.cloneNode(true)
    wizardButton.parentNode?.replaceChild(newButton, wizardButton)
    const currentButton = document.getElementById("wizard-menu-btn")

    // Handle scroll to show/hide label on desktop (not home page, and only if hasMenuLabel is false)
    if (!isHomePage && isDesktop && !hasMenuLabel) {
      scrollHandler = () => {
        updateLabelVisibility()
      }
      
      // Set initial state
      updateLabelVisibility()
      
      // Listen for scroll events
      window.addEventListener("scroll", scrollHandler, { passive: true } as AddEventListenerOptions)
      
      // Handle window resize
      resizeHandler = () => {
        updateLabelVisibility()
      }
      window.addEventListener("resize", resizeHandler, { passive: true } as AddEventListenerOptions)
    } else {
      // Update visibility based on hasMenuLabel and page context
      updateLabelVisibility()
    }

    // Click handler
    currentButton?.addEventListener("click", () => {
      // Check if label is visible (either via hasMenuLabel or via scroll)
      const hasMenuLabel = currentButton.dataset.hasMenuLabel === "true"
      const label = currentButton.querySelector(".wizard-menu-button__label")
      const isLabelVisible = hasMenuLabel || label?.classList.contains("wizard-menu-button__label--visible")
      
      // Don't execute if label is not visible
      if (!isLabelVisible) {
        return
      }

      const isDesktopNow = window.innerWidth >= 1024

      if (isDesktopNow) {
        // On desktop
        if (isHomePage) {
          // Scroll to menu section on home page
          const menuSection = document.getElementById("home-page__menu-section")
          if (menuSection) {
            menuSection.scrollIntoView({ behavior: "smooth" })
          }
        } else {
          // Scroll to top on non-home pages - nav bar will show and label will hide automatically
          window.scrollTo({ top: 0, behavior: "smooth" })
        }
      } else {
        // On mobile
        if (isHomePage) {
          // Scroll to menu section on home page
          const menuSection = document.getElementById("home-page__menu-section")
          if (menuSection) {
            menuSection.scrollIntoView({ behavior: "smooth" })
          } else {
            // Fallback if menu section not found (shouldn't happen on home)
            document.dispatchEvent(new CustomEvent("open-mobile-menu"))
          }
        } else {
          // Open mobile menu on non-home pages
          document.dispatchEvent(new CustomEvent("open-mobile-menu"))
        }
      }
    })
  }

  // Expose function to update hasMenuLabel on the client side
  function setHasMenuLabel(value: boolean) {
    const wizardButton = document.getElementById("wizard-menu-btn")
    if (!wizardButton) return

    wizardButton.dataset.hasMenuLabel = value.toString()
    updateLabelVisibility()
    
    // Re-initialize scroll handler if needed
    const isHomePage = wizardButton.dataset.isHome === "true"
    const isDesktop = window.innerWidth >= 1024
    
    if (!isHomePage && isDesktop && !value) {
      // Re-enable scroll handler if we're disabling hasMenuLabel
      if (!scrollHandler) {
        scrollHandler = () => {
          updateLabelVisibility()
        }
        window.addEventListener("scroll", scrollHandler, { passive: true } as AddEventListenerOptions)
      }
    } else if (scrollHandler) {
      // Remove scroll handler if we're enabling hasMenuLabel
      window.removeEventListener("scroll", scrollHandler, { passive: true } as AddEventListenerOptions)
      scrollHandler = null
    }
  }

  // Make function globally available
  (window as any).setWizardMenuLabel = setHasMenuLabel

  // Listen for custom event to update hasMenuLabel
  document.addEventListener("update-wizard-menu-label", ((e: CustomEvent) => {
    setHasMenuLabel(e.detail.hasMenuLabel)
  }) as EventListener)

  // Run on initial load and after every page transition
  document.addEventListener('astro:page-load', initWizardMenuButton);
  
  // Also run on initial DOM ready if not using view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWizardMenuButton)
  } else {
    initWizardMenuButton()
  }
</script>
