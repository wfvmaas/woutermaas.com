---
interface Props {
  isHomePage?: boolean
}

const { isHomePage = false } = Astro.props
---

<div class="wizard-menu-button" id="wizard-menu-btn" data-is-home={isHomePage} transition:name="wizard-button">
  <img src="/doodles/wizard_cloud_1.svg" alt="Menu" />
  <div class="wizard-menu-button__label" data-is-home={isHomePage}>Menu</div>
</div>

<style lang="less">
  @import "../styles/variables.less";
  @import "../styles/mixins.less";

  .wizard-menu-button {
    position: sticky;
    top: 1rem;
    right: 0.5rem;
    z-index: 100;
    float: right;
    cursor: pointer;
    text-align: center;

    // Visible on all screen sizes
    display: block;

    img {
      width: 4rem;
      height: auto;
      .transition(transform);

      @media (min-width: @screen-md) {
        width: 6rem;
      }
    }

    &__label {
      font-size: @text-lg;
      font-weight: 500;
      margin-top: 0.25rem;
      color: @color-black;
      transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
    }

    // Hide label on desktop when not on home page (until scroll)
    @media (min-width: @screen-md) {
      &[data-is-home="false"] &__label {
        opacity: 0;
        transform: translateY(-0.5rem);
        pointer-events: none;
      }

      // Show when scrolled - needs higher specificity
      &[data-is-home="false"] &__label--visible {
        opacity: 1 !important;
        transform: translateY(0) !important;
        pointer-events: auto;
      }
    }
  }
</style>

<script>
  let scrollHandler = null;
  let resizeHandler = null;

  function initWizardMenuButton() {
    const wizardButton = document.getElementById("wizard-menu-btn")
    if (!wizardButton) return

    const label = wizardButton.querySelector(".wizard-menu-button__label")
    if (!label) return

    const isHomePage = wizardButton.dataset.isHome === "true"
    const isDesktop = window.innerWidth >= 1024

    // Remove old event listeners if they exist
    if (scrollHandler) {
      window.removeEventListener("scroll", scrollHandler, { passive: true })
      scrollHandler = null
    }
    if (resizeHandler) {
      window.removeEventListener("resize", resizeHandler, { passive: true })
      resizeHandler = null
    }

    // Remove old click listener by cloning the button
    const newButton = wizardButton.cloneNode(true)
    wizardButton.parentNode?.replaceChild(newButton, wizardButton)
    const currentButton = document.getElementById("wizard-menu-btn")

    // Handle scroll to show/hide label on desktop (not home page)
    if (!isHomePage && isDesktop) {
      scrollHandler = () => {
        const scrollY = window.scrollY || window.pageYOffset
        const currentLabel = document.querySelector(".wizard-menu-button__label")
        if (currentLabel) {
          if (scrollY > 50) {
            currentLabel.classList.add("wizard-menu-button__label--visible")
          } else {
            currentLabel.classList.remove("wizard-menu-button__label--visible")
          }
        }
      }
      
      // Set initial state - hidden
      label.classList.remove("wizard-menu-button__label--visible")

      // Check initial scroll position
      scrollHandler()
      
      // Listen for scroll events
      window.addEventListener("scroll", scrollHandler, { passive: true })
      
      // Handle window resize
      resizeHandler = () => {
        const isDesktopNow = window.innerWidth >= 1024
        const currentLabel = document.querySelector(".wizard-menu-button__label")
        if (currentLabel) {
          if (isDesktopNow && !isHomePage) {
            scrollHandler()
          } else {
            // On mobile, always show label
            currentLabel.classList.add("wizard-menu-button__label--visible")
          }
        }
      }
      window.addEventListener("resize", resizeHandler, { passive: true })
    } else {
      // On home page or mobile, always show label
      label.classList.add("wizard-menu-button__label--visible")
    }

    // Click handler
    currentButton.addEventListener("click", () => {
      const isDesktopNow = window.innerWidth >= 1024

      if (isDesktopNow) {
        // On desktop
        if (isHomePage) {
          // Scroll to menu section on home page (restore previous behavior)
          const menuSection = document.getElementById("home-page__menu-section")
          if (menuSection) {
            menuSection.scrollIntoView({ behavior: "smooth" })
          }
        } else {
          // Scroll to top on other pages
          window.scrollTo({ top: 0, behavior: "smooth" })
        }
      } else {
        // On mobile, keep current behavior
        if (isHomePage) {
          // Scroll to menu section on home page
          const menuSection = document.getElementById("home-page__menu-section")
          if (menuSection) {
            menuSection.scrollIntoView({ behavior: "smooth" })
          } else {
            // Fallback if menu section not found (shouldn't happen on home)
            document.dispatchEvent(new CustomEvent("open-mobile-menu"))
          }
        } else {
          // Open modal on other pages
          document.dispatchEvent(new CustomEvent("open-mobile-menu"))
        }
      }
    })
  }

  // Run on initial load and after every page transition
  document.addEventListener('astro:page-load', initWizardMenuButton);
  
  // Also run on initial DOM ready if not using view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWizardMenuButton)
  } else {
    initWizardMenuButton()
  }
</script>
